# Copie para .env.local e preencha o que for usar. Também dá para colar as chaves
# direto no app (Configurações → Integrações) — elas ficam salvas só no servidor.

# Claude (Anthropic) — análise das peças, tradução, nomes, legendas, parecer dos especialistas
ANTHROPIC_API_KEY=

# Fotos com modelo por IA (use um dos dois)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Senha do UP Vendas (o domínio e o usuário ficam em Configurações → UP Vendas)
UPVENDAS_SENHA=

# Senha para entrar no app (recomendado quando o app estiver na internet)
APP_SENHA=

# Segredo que assina os logins (64 letras/números). Vazio = o app cria um e guarda no banco.
SESSAO_SEGREDO=

# Banco de dados: vazio = arquivo local ./dados/fiodeamor.db
# Na nuvem (Turso): DATABASE_URL=libsql://seu-banco.turso.io  e  DATABASE_AUTH_TOKEN=...
DATABASE_URL=
DATABASE_AUTH_TOKEN=
